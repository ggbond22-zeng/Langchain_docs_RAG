# LangChain 文档 MCP 检索服务 —— 配置模板
# 复制为 .env 后按需修改：cp .env.example .env

# ============ 必填：上游 API 凭证 ============
# 本项目用 OpenAI 兼容接口做「向量化 + 查询改写 + 精排」，三者共用同一个 Key。
# 默认按硅基流动（SiliconFlow）的接口配置，也可以换成任何 OpenAI 兼容服务。
# 远程托管时可以不填——客户端可在请求头携带 X-Api-Key 走 BYOK（自带 Key）。
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.siliconflow.cn/v1

# ============ Milvus 连接 ============
MILVUS_URI=http://localhost:19530
MILVUS_DB=langchain_docs_db
MILVUS_COLLECTION=langchain_docs_llms_v1

# ============ 模型 ============
EMBED_MODEL=Qwen/Qwen3-Embedding-4B
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ============ 文档来源（入库与 get_document 用）============
# 官方每个文档分区都有 llms.txt 清单；多个分区用英文逗号分隔
LLMS_INDEX_URLS=https://docs.langchain.com/oss/python/langchain/llms.txt
LLMS_INDEX_URL=https://docs.langchain.com/oss/python/langchain/llms.txt

# ============ 分块参数（入库时生效，改动后需重新入库）============
CHUNK_SIZE=800
CHUNK_OVERLAP=100
EMBED_BATCH=32
# 必须分批写入：一次性写入上千条向量会触发 gRPC 64MB 消息上限错误
UPSERT_BATCH=200

# ============ 检索参数 ============
QUERY_VARIANTS=3
RECALL_K=8
RRF_K=60
RERANK_CANDIDATES=12
# rerank 分数低于此值视为不相关，宁可回答「未检索到」也不编造
MIN_SCORE=0.3

# ============ 服务与传输 ============
# stdio（本地客户端拉起）| streamable-http（远程托管）| sse（旧版远程，已不推荐）
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
HTTP_TIMEOUT=30
